# Dockerfile.airflow
#
# Custom Apache Airflow image for the weather ETL pipeline.
#
# Extends the official Airflow image with:
#   - Java 17 (required by PySpark)
#   - Project Python dependencies (pyspark, pymongo, etc.)
#
# The official entrypoint and health checks are preserved.

FROM apache/airflow:2.10.5-python3.11

# ------------------------------------------------------------
# System dependencies (must run as root)
# ------------------------------------------------------------
USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        procps \
        curl && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ------------------------------------------------------------
# Python dependencies (switch back to airflow user)
# ------------------------------------------------------------
USER airflow

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
